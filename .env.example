# LM Studio (OpenAI-compatible local API)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gpt-oss:20b
# Не нужен реальный ключ для LM Studio, но langchain требует непустую строку
OPENAI_API_KEY=lm-studio

# Gitea
GITEA_URL=https://git.bro-js.ru
GITEA_TOKEN=your_gitea_token_here
GITEA_OWNER=your_username

# Platform MCP (платформа препода)
PLATFORM_MCP_URL=https://platform.brojs.ru/mcp
# Токен для платформы (если нужен)
PLATFORM_TOKEN=

# Репозиторий для сдачи решений
SOLUTIONS_REPO=cucumbers-solutions
# Создать репо если не существует (true/false)
AUTO_CREATE_REPO=true
