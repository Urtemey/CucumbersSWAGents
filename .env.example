# ── LLM (через brojs jrnl-туннель к их inference-серверу) ────────────────
# Канонические имена. Старые LM_STUDIO_* поддерживаются как fallback-алиасы.
LLM_BASE_URL=https://platform.brojs.ru/jrnl-bh/api/inference/v1
LLM_MODEL=gpt-oss:20b
# Заглушка — config подставит PLATFORM_TOKEN для platform.brojs.ru
OPENAI_API_KEY=lm-studio

# ── Gitea (куда пушим решения) ───────────────────────────────────────────
GITEA_URL=https://git.brojs.ru
GITEA_TOKEN=your_gitea_token_here
GITEA_OWNER=your_username

# ── Journal MCP (фетч заданий + сдача через платформу) ──────────────────
# Endpoint Journal MCP — рабочий, инструменты tasks_list / task_get / task_text / task_submit и др.
# Транспорт http, Bearer auth. URL уже зашит в config.py — можно оставить пустым.
PLATFORM_MCP_URL=https://platform.brojs.ru/jrnl-bh/api/mcp
# jrnl-токен: platform.brojs.ru → профиль → токены. JOURNAL_TOKEN — каноническое имя,
# PLATFORM_TOKEN — legacy-алиас (поддерживается).
JOURNAL_TOKEN=jrnl_your_token_here

# ── Репозиторий для сдачи решений ────────────────────────────────────────
SOLUTIONS_REPO=cucumbers-solutions
AUTO_CREATE_REPO=true
